[Unit]
Description=SIPAT Online daily Postgres backup to R2
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# the deploy writes the R2 key of the backups in deploy/.env.production; HOME only matters
# for a VM still configured by hand with `rclone config`
Environment=HOME=/root
WorkingDirectory=/opt/sipat-online/app
ExecStart=/opt/sipat-online/app/deploy/scripts/backup-postgres.sh
