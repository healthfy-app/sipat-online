# Production: copy to production.tfvars (ignored by Git) and fill in. Apply with the "production" workspace.
environment     = "production"
location        = "brazilsouth"
create_dns_zone = true
domain_name     = "example.com"
acme_email      = "admin@example.com"

vm_size         = "Standard_B2s"
image_sku       = "server"
os_disk_type    = "StandardSSD_LRS"
os_disk_size_gb = 64
swap_size_mb    = 0

admin_username      = "sipatadmin"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
# 0.0.0.0/0 only if the GitHub pipeline deploys (key-only login); x.x.x.x/32 when only people deploy
ssh_allowed_cidr = "0.0.0.0/0"
# public key of the production deploy pipeline (its private key is the DEPLOY_SSH_PRIVATE_KEY secret)
additional_ssh_public_keys = []
