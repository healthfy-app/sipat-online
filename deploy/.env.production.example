POSTGRES_DB=sipat_online
POSTGRES_USER=sipat_online
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Domain of the platform. Companies are <key>.<TENANT_BASE_DOMAIN>; the operation lives at PLATFORM_HOST.
TENANT_BASE_DOMAIN=example.com
PLATFORM_HOST=ops.example.com

# The owner of the platform (operation). Created on the first start; after that the password can be removed from this file.
PLATFORM_OPERATOR_LOGIN_IDENTIFIER=owner.login
PLATFORM_OPERATOR_DISPLAY_NAME=Owner Name
PLATFORM_OPERATOR_PASSWORD=replace-with-a-long-random-first-password

# Optional first company. Leave all three empty to start with no company at all.
TENANT_ID=
TENANT_KEY=
TENANT_NAME=

# Optional, only with a first company: its first administrator. Configure the three together or leave empty.
BOOTSTRAP_ADMIN_LOGIN_IDENTIFIER=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Armazenamento dos videos da biblioteca. File (padrao) guarda no volume da VM e serve pela propria API (plano B).
# R2 guarda no Cloudflare R2 e o participante assiste por links assinados e temporarios. Com R2, as quatro variaveis abaixo sao obrigatorias.
# VIDEO_STORAGE_PROVIDER=R2
# Endereco da conta no R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_SERVICE_URL=https://replace-with-account-id.r2.cloudflarestorage.com
# Chave de API do R2 (token S3 com permissao de leitura e escrita somente neste bucket). Nunca registre em log nem versione.
# R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
# R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# Bucket privado dos videos.
# R2_VIDEO_BUCKET=sipat-videos

# Conversao de videos: ligada sempre no compose.production.yaml (SipatOnline__VideoConversion__Enabled=true), nao ha variavel aqui.
# Cada envio vira 720p e 480p dentro da propria API (o ffmpeg vem na imagem), um video por vez e em prioridade baixa.
# Enquanto converte, o original fica no volume video-work (/var/sipat/video-work) e o video aparece como "Processando";
# um video "Processando" nao entra num Dia. Os videos enviados antes desta versao ganham so a 480p (a 720p nao e recodificada) com
# "exec api dotnet SipatOnline.Api.dll --convert-catalog-videos" (veja deploy/CLOUDFLARE-VM.md, secao 5).

# Bucket PRIVADO do R2 para o backup diario do banco (separado do bucket de videos). Usado por deploy/scripts/backup-postgres.sh.
# O remote do rclone chamado "r2" deve ter permissao de leitura e escrita neste bucket. Veja deploy/CLOUDFLARE-VM.md.
# R2_BACKUP_BUCKET=sipat-backups
