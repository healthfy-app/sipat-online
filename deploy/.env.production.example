POSTGRES_DB=sipat_online
POSTGRES_USER=sipat_online
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Domain of the platform. Companies are <key>.<TENANT_BASE_DOMAIN>; the operation lives at PLATFORM_HOST.
TENANT_BASE_DOMAIN=example.com
PLATFORM_HOST=ops.example.com

# The owner of the platform (operation). Created on the first start; after that the password can be removed from this file.
PLATFORM_OPERATOR_LOGIN_IDENTIFIER=owner.login
PLATFORM_OPERATOR_DISPLAY_NAME=Owner Name
PLATFORM_OPERATOR_PASSWORD=replace-with-a-long-random-first-password

# Optional first company. Leave all three empty to start with no company at all.
TENANT_ID=
TENANT_KEY=
TENANT_NAME=

# Optional, only with a first company: its first administrator. Configure the three together or leave empty.
BOOTSTRAP_ADMIN_LOGIN_IDENTIFIER=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
